APP_NAME=简历评价智能体
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_USER=resume
MYSQL_PASSWORD=
MYSQL_DATABASE=resume_ai
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/resume_ai?charset=utf8mb4
DEFAULT_USER_NAME=guest
SESSION_SECRET=change-this-to-a-random-32-byte-secret
SESSION_COOKIE_NAME=resume_ai_session
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=false
ALLOW_REGISTER=true
ADMIN_USERNAME=admin
# 评委演示默认密码（正式上线前请务必修改）
ADMIN_PASSWORD=ResumeAi@2026
ADMIN_DISPLAY_NAME=系统管理员
# 填写后默认优先调用 DeepSeek；留空时自动回退离线规则分析
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# 批量分析并行度（离线 1-4，开启 AI 时上限 2）
BATCH_PARALLEL_WORKERS=2
MAX_UPLOAD_SIZE_MB=20
MAX_ZIP_TOTAL_SIZE_MB=120
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# 异步任务（Docker 默认可开启；本地开发可保持 false）
REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=false

# 生产环境建议
# SESSION_COOKIE_SECURE=true
# ALLOW_REGISTER=false
# 详见 docs/部署指南.md
