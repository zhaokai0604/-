APP_NAME=简历评价智能体
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_USER=resume
MYSQL_PASSWORD=
MYSQL_DATABASE=resume_ai
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/resume_ai?charset=utf8mb4
DEFAULT_USER_NAME=guest
SESSION_SECRET=generate-a-unique-random-secret-before-use
SESSION_COOKIE_NAME=resume_ai_session
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8000
ALLOW_REGISTER=true
ADMIN_USERNAME=admin
# 评委演示默认密码（正式上线前请务必修改）
ADMIN_PASSWORD=ChangeThisDemoPassword1
ADMIN_DISPLAY_NAME=系统管理员
# 填写后默认优先调用 DeepSeek；留空时自动回退离线规则分析
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# 批量分析并行度（离线 1-4，开启 AI 时上限 2）
BATCH_PARALLEL_WORKERS=2
MAX_UPLOAD_SIZE_MB=20
MAX_ZIP_TOTAL_SIZE_MB=120
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# 异步任务（Docker 默认可开启；本地开发可保持 false）
REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=false
# 岗位匹配：规则分与语义分融合（默认开启，无需额外模型）
USE_SEMANTIC_MATCH=true
MATCH_RULE_WEIGHT=0.65
# 可选：安装 sentence-transformers 后设为 true，使用中文向量模型
# 见 backend/requirements-semantic.txt；微调：backend/scripts/train_sbert.py
# 默认关闭；只有经过独立留出验证的实验模型才显式开启
USE_SEMANTIC_MODEL=false
# 仅显式指定经过独立留出验证的实验模型时开启；不要指向默认权重目录
# SEMANTIC_MODEL_PATH=
# 仅显式指定独立实验中拟合的融合器时使用；默认不加载实验权重
# SEMANTIC_BLENDER_PATH=
SEMANTIC_MODEL_NAME=shibing624/text2vec-base-chinese
# 国内下载基座可设：HF_ENDPOINT=https://hf-mirror.com

# 生产环境建议
# SESSION_COOKIE_SECURE=true
# ALLOW_REGISTER=false
# 详见 docs/部署指南.md
